// Threadhunt — модель данных. Мультиарендность: почти у каждой сущности есть userId,
// и все запросы фильтруются по текущему пользователю.
//
// Для локального превью используется SQLite (ноль зависимостей, без Docker).
// В проде — Postgres: поменяй provider на "postgresql" и DATABASE_URL.
// Статусы хранятся строками (а не enum), чтобы схема работала на обоих движках.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Аккаунты ─────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  plan         String    @default("FREE") // FREE | PRO | VIP
  role         String    @default("USER") // USER | ADMIN
  acceptedTermsAt DateTime? // когда принял условия (риск Threads-аккаунта на пользователе)
  acceptedDataUseAt DateTime? // согласие на обезличенную аналитику для улучшения сервиса (opt-in)
  extraSeats   Int       @default(0) // докупленные доп-места (аккаунты сверх тарифа); со Stripe — автоматически
  webhookUrl   String?   // исходящий вебхук: новый лид / ответы анкеты POST-ятся сюда (Zapier/Make/Telegram/Sheets)
  webhookSecret String?  // отправляется в заголовке X-Threadhunt-Secret для проверки подлинности
  webhookEvents String?  // CSV выбранных событий (пусто = все): lead.created,candidate.response,candidate.completed
  resetTokenHash      String?   // сброс пароля: хеш одноразового токена
  resetTokenExpiresAt DateTime? // срок действия токена сброса
  lastSeenAnnouncementAt DateTime? // когда пользователь последний раз открывал колокольчик (для непрочитанных)
  // ── Telegram-бот (сводки и уведомления) ──
  telegramChatId   String?  // chatId привязанного телеграм-аккаунта (куда слать)
  telegramLinkToken String? // одноразовый токен для привязки через /start (ищем через findFirst)
  tgNotifyLeads    Boolean  @default(true)  // уведомлять о новых кандидатах
  tgNotifyTests    Boolean  @default(true)  // уведомлять о сдаче/просрочке тестового
  tgDailySummary   Boolean  @default(true)  // ежедневная сводка
  tgSummarySentOn  String?  // дата последней отправленной сводки (YYYY-MM-DD), анти-дубль
  isDemo       Boolean   @default(false) // демо-аккаунт для тура (можно массово очистить)
  createdAt    DateTime  @default(now())

  connections  ThreadsConnection[]
  searches     Search[]
  leads        Lead[]
  devices      Device[]
  subscription Subscription?
  brandProfile BrandProfile?
  aiUsage      AiUsage[]
  limits       Limits?
  ownedTeam    Membership[] @relation("WorkspaceOwner")
  memberOf     Membership[] @relation("WorkspaceMember")
  flowTemplates FlowTemplate[]
  metaConnection MetaConnection?
  adCampaigns    AdCampaign[]
  agentPasses    AgentPass[]
  researchPosts  ResearchPost[]
  agentLogs      AgentLog[]
}

// Участник рабочего пространства (командный доступ с ограниченными правами).
model Membership {
  id        String   @id @default(cuid())
  ownerId   String // владелец пространства (чьи данные)
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  email     String // приглашённый email
  memberId  String? // связанный пользователь (когда зарегистрируется/войдёт)
  member    User?    @relation("WorkspaceMember", fields: [memberId], references: [id])
  role      String   @default("MANAGER") // MANAGER (ведёт лиды) | VIEWER (только чтение)
  createdAt DateTime @default(now())

  @@unique([ownerId, email])
  @@index([memberId])
  @@index([email])
}

// Лимиты авто-отбивки (защита Threads-аккаунта). На аккаунт пользователя.
// Расширение получает их в задачах и строго соблюдает.
model Limits {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyDelaySec       Int     @default(8) // пауза между ответами, сек
  maxRepliesPerDay    Int     @default(40) // максимум отправленных сообщений в день
  maxDialogsPerSweep  Int     @default(40) // «чатов за проход» — макс. диалогов за обход
  workingHoursEnabled Boolean @default(false) // отвечать только в рабочие часы
  activeFrom          String  @default("09:00") // HH:MM
  activeTo            String  @default("21:00") // HH:MM
  // ── Параметры прохода отбивки (читает расширение) ──
  sweepIntervalMinutes Int     @default(180) // как часто запускать обход директа (мин)
  safeMode             Boolean @default(false) // безопасный режим: проходить и считать, но НЕ отправлять
  sweepMain            Boolean @default(true)  // обходить основной директ
  sweepRequests        Boolean @default(true)  // обходить «Запросы»
  sweepHidden          Boolean @default(true)  // обходить «Скрытые»
  runNowAt             DateTime? // «Прогон сейчас»: метка, по которой расширение запустит обход вне расписания
  researchEnabled      Boolean @default(false) // сбор топовых вакансий-веток в Threads (research через расширение)
  researchByKeywords   Boolean @default(false) // искать ветки по кодовым словам (true) или по названию роли (false)
  researchRunAt        DateTime? // «Собрать топ-ветки сейчас»: метка для немедленного research-прохода
  researchLastRunAt    DateTime? // когда расширение последний раз завершило research-проход (даже с 0 результатами)
  researchDiag         String? // диагностика вёрстки выдачи Threads (JSON) — для отладки селекторов сбора
  // Холостой ТЕСТ отбивки из дашборда (без отправки/приёма): запрос + результат.
  dmTestAt             DateTime? // запрошен тест — расширение запустит холостой проход
  lastTestAt           DateTime? // когда пришёл результат теста
  lastTestScanned      Int     @default(0) // диалогов осмотрено в тесте
  lastTestMatched      Int     @default(0) // совпадений найдено в тесте
  stopAt               DateTime? // «Стоп»: метка, по которой расширение прерывает текущий проход
  passStartedAt        DateTime? // когда расширение начало текущий проход (для статуса «идёт проход»); гасится по завершении
  tabClosedAt          DateTime? // фоновая рабочая вкладка закрыта до завершения прохода (для уведомления в дашборде)
  // ── ИИ-калибровка разметки под язык/браузер/вёрстку конкретного юзера ──
  calibrateAt          DateTime? // «Перекалибровать»: метка — расширение снимет вёрстку и отправит на ИИ
  calibratedAt         DateTime? // когда последний раз успешно откалибровано
  calibration          String?   // JSON: лейблы/селекторы кнопок (Принять/Показать/OK/Отклонить) от Claude
  calibrationInfo      String?   // браузер + язык интерфейса (для показа статуса в дашборде)
}

// Собранные research-постом: топовые вакансии-ветки из поиска Threads (через
// расширение в браузере клиента). Дедуп по (userId, threadsPostId), метрики
// обновляются при повторном сборе. Источник «насмотренности» для генерации постов.
model ResearchPost {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchId      String?
  query         String // по какому запросу нашли
  threadsPostId String
  author        String?
  text          String
  permalink     String?
  likes         Int      @default(0)
  replies       Int      @default(0)
  reposts       Int      @default(0)
  postedAt      DateTime?
  fetchedAt     DateTime @default(now())

  @@unique([userId, threadsPostId])
  @@index([userId, searchId])
}

// Объявления основателя → всем пользователям (новости/обновления/важное).
// Видны в колокольчике. Непрочитанность считается по User.lastSeenAnnouncementAt.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  level     String   @default("info") // info | update | important
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Журнал проходов отбивки (телеметрия от расширения): статистика последнего
// обхода для карточки «Отбивка в директе» и ленты «что происходит на бэке».
// Проход глобальный по аккаунту (один обход покрывает все активные поиски).
model AgentPass {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanned  Int      @default(0) // диалогов осмотрено
  sent     Int      @default(0) // ответов отправлено
  matched  Int      @default(0) // совпадений по кодовым словам найдено
  sections String? // какие разделы обходили (csv: main,requests,hidden)
  dryRun   Boolean  @default(false) // безопасный/тестовый проход
  at       DateTime @default(now())

  @@index([userId, at])
}

// Живой журнал событий отбивки: что бот делает прямо сейчас (заходит в раздел,
// осмотрел N, ответил @user…). Кольцевой буфер — храним последние ~100 строк на юзера.
model AgentLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level  String   @default("info") // info | reply | warn
  text   String
  at     DateTime @default(now())

  @@index([userId, at])
}

// Учёт расхода ИИ — по пользователю и дню (для лимитов по тарифам).
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String // YYYY-MM-DD
  count  Int    @default(0)

  @@unique([userId, day])
  @@index([userId])
}

// «Голос бренда» — персонализация ИИ под конкретного клиента (его критерии/стиль).
// Это и есть «обучение под себя» без файнтюна: пользователь задаёт тон/фишки/пример,
// и они подставляются во все генерации. См. ai/generate.ts.
model BrandProfile {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ── Рабочее пространство / организация ──
  companyName String @default("") // название компании/проекта
  niche       String @default("") // ниша (напр. «продюсерский центр», «онлайн-школа»)
  social      String @default("") // соцсеть/ссылка профиля
  about       String @default("") // короткое описание команды
  // ── Голос бренда (для ИИ) ──
  tone      String @default("") // напр. «на ты, дружелюбно, с лёгким юмором»
  audience  String @default("") // кого ищем / кто аудитория
  perks     String @default("") // чем привлекаем (плюсы работы)
  signature String @default("") // как заканчивать / куда вести
  sample    String @default("") // пример удачного поста — референс стиля
  avoid     String @default("") // что НЕ использовать (стоп-слова/клише)
  teamContacts String @default("") // JSON [{name, telegram}] — контакты команды для вставки в ответы директа
}

// Подключённый Threads-аккаунт клиента.
// Для постинга — OAuth-токен (шифруется на уровне приложения).
// Для отбивки — к нему привязывается Device (расширение).
model ThreadsConnection {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadsUserId  String
  username       String
  // accessToken хранится ЗАШИФРОВАННЫМ (AES-256-GCM), не отдаётся в API.
  accessTokenEnc String?
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())

  devices  Device[]
  searches Search[]

  @@unique([userId, threadsUserId])
  @@index([userId])
}

// Подключение рекламного кабинета Meta (для авто-кампаний лидгена на директ).
// На MVP — ручной ввод; реальный запуск через Marketing API ждёт App Review Meta,
// поэтому status по умолчанию «pending» (на модерации). OAuth добавится тем же интерфейсом.
model MetaConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccountId    String   @default("") // act_XXXXXXXX
  businessName   String   @default("")
  metaUserId     String? // app-scoped user id Meta (для deauthorize/удаления данных)
  accessTokenEnc String? // зашифрован (AES-256-GCM), не отдаётся в API
  status         String   @default("pending") // pending (на модерации) | active
  createdAt      DateTime @default(now())
}

// Рекламная кампания: предсобранная «связка» (креатив+копирайт+аудитория) под роль.
// Лидген на директ → кодовое слово ловит расширение → автоответ → онбординг.
// Запуск в Ads Manager пока недоступен (модерация Meta) — кампании живут как черновики.
model AdCampaign {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchId String
  search   Search @relation(fields: [searchId], references: [id], onDelete: Cascade)

  name      String
  bundleKey String @default("") // ключ пресета из библиотеки связок
  status    String @default("draft") // draft | pending_review | active | paused
  objective String @default("messages") // лидген на директ

  dailyBudget Int    @default(500) // дневной бюджет (целое, в валюте)
  currency    String @default("RUB")
  geo         String @default("") // гео-таргет (текстом)
  ageMin      Int    @default(18)
  ageMax      Int    @default(45)
  interests   String @default("") // детальный таргетинг (интересы)

  creativeHeadline String  @default("")
  creativeText     String  @default("")
  mediaUrl         String?
  mediaType        String? // image | video
  codeWord         String  @default("") // кодовое слово для автоответа в директе
  ctaLabel         String  @default("Написать в директ")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([searchId])
}

// Экземпляр расширения у клиента (исполнитель отбивки).
// Привязан к аккаунту пользователя. Официальное Threads-подключение НЕ требуется
// (отбивка работает в браузере клиента под его сессией, без Meta).
model Device {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId    String?
  connection      ThreadsConnection? @relation(fields: [connectionId], references: [id])
  // device-token хранится как хеш; отзываемый.
  tokenHash       String             @unique
  label           String?
  version         String?
  lastHeartbeat   DateTime?
  threadsLoggedIn Boolean            @default(false)
  createdAt       DateTime           @default(now())

  @@index([userId])
}

// ───────────────────────── Ядро: гибкий «поиск сотрудника» ─────────────────────────

model Search {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   ThreadsConnection? @relation(fields: [connectionId], references: [id])

  title       String // напр. «Видеомонтажёр», «UI-дизайнер»
  description String   @default("") // вводные для ИИ и для себя
  status      String   @default("ACTIVE") // ACTIVE | PAUSED
  createdAt   DateTime @default(now())

  // ── Онбординг кандидата (публичная пошаговая ссылка) ──
  obEnabled    Boolean @default(false)
  obConditions String  @default("") // условия участия (legacy/быстрый режим)
  obTestTask   String  @default("") // тестовое задание (legacy)
  obNda        String  @default("") // текст NDA (legacy)
  obFlow       String? // JSON конструктора: страницы + блоки (приоритетнее legacy-полей)
  // Дедлайн сдачи тестового
  obDeadlineMode String  @default("none") // none | relative | fixed
  obDeadlineHours Int    @default(48) // для relative: часов с момента старта
  obDeadlineAt   DateTime? // для fixed: абсолютный момент (UTC)
  obTimezone     String  @default("") // IANA-зона для показа кандидату (пусто = его локальная)
  obRemindersEnabled Boolean @default(true) // слать кандидату email-напоминания о дедлайне теста
  obLinkInReply  Boolean @default(false) // вкладывать персональную ссылку онбординга в авто-ответ директа

  // ── Автопланировщик целей найма ──
  goalEnabled    Boolean   @default(false)
  goalHires      Int       @default(0) // сколько человек нужно нанять
  goalConversion Int       @default(10) // ожидаемая конверсия лид→найм, %
  goalDueAt      DateTime? // к какой дате
  goalStartedAt  DateTime? // когда цель поставлена (отсчёт прогресса)

  keywords       Keyword[]
  replyTemplates ReplyTemplate[]
  postTemplates  PostTemplate[]
  publishConfig  PublishConfig?
  commentRules   CommentRule[]
  leads          Lead[]
  publishedPosts PublishedPost[]
  adCampaigns    AdCampaign[]

  @@index([userId])
}

model Keyword {
  id       String @id @default(cuid())
  searchId String
  search   Search @relation(fields: [searchId], references: [id], onDelete: Cascade)
  text      String
  mode      String  @default("root") // root | word | exact
  replyText String? // персональный ответ под это слово; пусто → берётся общий шаблон поиска

  @@index([searchId])
}

model ReplyTemplate {
  id             String @id @default(cuid())
  searchId       String
  search         Search @relation(fields: [searchId], references: [id], onDelete: Cascade)
  text           String
  redirectTarget String @default("") // напр. Telegram @username или URL
  source         String @default("manual") // manual | ai
  order          Int    @default(0)

  leads Lead[]

  @@index([searchId])
}

model PostTemplate {
  id        String  @id @default(cuid())
  searchId  String
  search    Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  text      String
  // Медиа по ПУБЛИЧНОЙ ссылке (требование Threads API): image_url / video_url.
  // ЛЕГАСИ-зеркало первого сегмента: text/mediaUrl/mediaType = сегмент[0] и его
  // первое медиа. Источник правды для карусели и цепочек веток — segmentsJson.
  mediaUrl  String? // публичный URL картинки/видео (первое медиа корневого поста)
  mediaType String? // image | video | null (только текст)
  // Карусель + цепочка веток. JSON-массив сегментов (как obFlow в Search):
  //   [{ "text": "...", "media": [{ "url": "...", "type": "image|video" }, ...] }, ...]
  // segment[0] = корневой пост, остальные = ответы-«ветки» (reply_to_id).
  // media длиной >1 → карусель (Threads CAROUSEL). Пусто/нет → берём легаси-поля.
  segmentsJson String?
  source    String  @default("manual") // manual | ai
  order     Int     @default(0)
  lastPublishedAt DateTime? // когда этот шаблон последний раз успешно опубликовали

  @@index([searchId])
}

// Расписание авто-постинга (перенос логики из server.js).
model PublishConfig {
  id              String  @id @default(cuid())
  searchId        String  @unique
  search          Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  enabled         Boolean @default(false)
  intervalMinutes Int     @default(240)
  maxPerDay       Int     @default(5)
  rotation        String  @default("sequential") // sequential | random
  nextIndex       Int     @default(0)
}

// Правило отбивки в комментариях. Через Threads API: при новом ответе под нашим
// постом бот публикует ответ (mode=keyword — только если текст содержит кодовое
// слово; mode=all — на любой комментарий). Требует scope threads_read_replies +
// threads_manage_replies (Meta App Review).
model CommentRule {
  id        String  @id @default(cuid())
  searchId  String
  search    Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  enabled   Boolean @default(false)
  mode      String  @default("keyword") // keyword | all
  replyText String  @default("")

  // Уникальность «одно правило на поиск» держим на уровне приложения (см. routes/searches.ts),
  // чтобы не добавлять @unique на существующую таблицу — это ломает `prisma db push`
  // (data-loss warning) в деплое Railway.
  @@index([searchId])
}

// Дедуп авто-ответов на комментарии: на один ответ Threads отвечаем один раз.
model CommentReply {
  id        String   @id @default(cuid())
  searchId  String
  replyId   String   @unique // id комментария в Threads
  createdAt DateTime @default(now())

  @@index([searchId])
}

// ───────────────────────── Лиды (ценный выхлоп) ─────────────────────────

model Lead {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchId        String
  search          Search         @relation(fields: [searchId], references: [id], onDelete: Cascade)
  fromUserKey     String // стабильный ключ (id чата) для дедупа
  fromUsername    String?
  matchedKeyword  String
  section         String? // requests | hidden | main — откуда пришёл лид
  message         String? // вступительное сообщение кандидата (что написал помимо кодового слова)
  replyTemplateId String?
  replyTemplate   ReplyTemplate? @relation(fields: [replyTemplateId], references: [id])
  status          String         @default("REPLIED") // REPLIED | FAILED | MANUAL — ответил ли бот
  // Стадия найма (канбан-пайплайн): NEW | CONTACTED | SCREENING | HIRED | BENCH | REJECTED
  stage           String         @default("NEW")
  rating          Int            @default(0) // 0..5 — субъективная оценка кандидата
  createdAt       DateTime       @default(now())

  // ── Поля жизненного цикла (CRM) ──
  contact          String? // куда увели кандидата (Telegram и т.п.)
  conditionsSentAt DateTime? // отправлены условия
  testSentAt       DateTime? // выдано тестовое
  testDeadlineAt   DateTime? // дедлайн по тестовому (обычно +1–2 ч)
  testSubmittedUrl String? // ссылка на сданное тестовое
  testSubmittedAt  DateTime? // когда сдал
  decisionReason   String? // причина отказа/решения
  role             String? // роль при найме
  rate             String? // ставка/оплата (свободный текст)
  startedAt        DateTime? // дата старта работы
  nextTouchAt      DateTime? // следующее касание (для резерва)

  // ── Онбординг по уникальной ссылке ──
  onboardToken       String?   @unique // токен публичной ссылки
  candidateName      String?
  candidateContact   String? // что кандидат сам оставил (TG/почта)
  candidatePortfolio String?
  consentAt          DateTime? // согласие на обработку данных
  ndaAcceptedAt      DateTime?
  obStep             Int       @default(0) // прогресс по шагам (аналитика воронки)
  candidateResponses String? // JSON ответов кандидата по блокам конструктора
  obReminderCount    Int       @default(0) // сколько email-напоминаний о дедлайне отправлено
  obLastReminderAt   DateTime? // когда отправляли последнее напоминание (анти-спам)

  comments LeadComment[]

  @@unique([searchId, fromUserKey]) // дедуп по человеку в рамках поиска
  @@index([userId])
  @@index([stage])
}

// Комментарии/заметки по кандидату — лента в карточке пайплайна.
model LeadComment {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  author    String   @default("Вы")
  createdAt DateTime @default(now())

  @@index([leadId])
}

model PublishedPost {
  id            String   @id @default(cuid())
  searchId      String
  search        Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  threadsPostId String?
  permalink     String?
  text          String
  mediaType     String? // text | image | video
  mediaUrl      String? // ссылка на медиа для превью в истории
  ok            Boolean  @default(true)
  error         String?
  createdAt     DateTime @default(now())

  @@index([searchId])
}

// ───────────────────────── ИИ и биллинг ─────────────────────────

model AiJob {
  id        String   @id @default(cuid())
  searchId  String
  kind      String // posts | replies
  status    String   @default("queued") // queued | running | done | failed
  result    String? // JSON-строка (массив вариантов) — SQLite не поддерживает Json-тип
  error     String?
  createdAt DateTime @default(now())

  @@index([searchId])
}

// Сохранённый шаблон онбординг-флоу (библиотека под разные роли).
model FlowTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  flow      String // JSON конструктора
  createdAt DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("inactive")
  plan                 String    @default("FREE")
  currentPeriodEnd     DateTime?
}

// Заявки с лендинга (лист ожидания / ранний доступ). Не привязаны к аккаунту.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?  // landing | utm_source (fb/ig/…) | referral
  utm       String?  // JSON UTM-меток рекламы (source/medium/campaign/content/term + fbclid)
  status    String   @default("new") // new | invited | converted
  promoCode String?  // выданный уникальный промокод (для ранних/листа ожидания)
  isDemo    Boolean  @default(false) // демо-заявка для тура
  createdAt DateTime @default(now())
}

// Email-цепочка (drip) для новых пользователей: последовательность писем с
// задержками. steps — JSON [{ delayHours, subject, blocks:[{type,...}] }].
// Реальная отправка — через Resend (когда подключён); конструктор/хранение — здесь.
model EmailSequence {
  id        String   @id @default(cuid())
  name      String
  audience  String   @default("new_users") // new_users | waitlist
  steps     String   @default("[]") // JSON шагов цепочки
  segment   String?  // JSON сегмент-фильтров получателей (статусы/тарифы/активация/…)
  enabled   Boolean  @default(false)
  isDemo    Boolean  @default(false) // демо-цепочка для тура
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Промокод запуска. Защита от повторного применения: уникальный код на человека
// + лимит применений (по умолчанию 1) + привязка к аккаунту через PromoRedemption.
// Stripe станет финальным валидатором (Promotion Code, max_redemptions=1); эта
// таблица — наш источник правды и работает до подключения Stripe.
model PromoCode {
  id             String   @id @default(cuid())
  code           String   @unique
  percentOff     Int      @default(50) // размер скидки, %
  durationMonths Int      @default(2) // на сколько месяцев действует скидка
  maxRedemptions Int      @default(1) // сколько раз код можно применить (глобально)
  redeemedCount  Int      @default(0) // сколько уже применено
  expiresAt      DateTime? // срок действия (пусто = бессрочно)
  campaign       String   @default("early") // метка кампании (early/launch/…)
  issuedToEmail  String? // кому выдан (email из листа ожидания)
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())

  redemptions PromoRedemption[]

  @@index([issuedToEmail])
  @@index([campaign])
}

// Факт применения промокода аккаунтом. Уникальность (codeId,userId) + лимит
// maxRedemptions не дают применить дважды и «на 100%».
model PromoRedemption {
  id        String    @id @default(cuid())
  codeId    String
  code      PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime  @default(now())

  @@unique([codeId, userId])
  @@index([userId])
}

// Учёт отправленных шагов drip-цепочки (дедуп + расчёт, когда слать следующий).
model EmailDrip {
  id         String   @id @default(cuid())
  userId     String
  sequenceId String
  stepIndex  Int
  sentAt     DateTime @default(now())

  @@unique([userId, sequenceId, stepIndex])
  @@index([userId])
}
