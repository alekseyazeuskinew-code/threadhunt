{
  "name": "@threadhunt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "prisma": "prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@prisma/client": "^5.20.0",
    "@threadhunt/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
