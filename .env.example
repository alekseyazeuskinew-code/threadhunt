# --- БД и очереди ---
# Локальное превью (без Docker): SQLite-файл.
DATABASE_URL="file:./dev.db"
# Прод: Postgres (поменяй provider в prisma/schema.prisma на "postgresql"):
# DATABASE_URL="postgresql://threadhunt:threadhunt@localhost:5432/threadhunt?schema=public"

# --- Шифрование токенов клиентов (AES-256-GCM, 32 байта в hex = 64 символа) ---
# Сгенерировать: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# --- Сессии дашборда ---
SESSION_SECRET=""

# --- Threads / Meta OAuth (для авто-постинга) ---
THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_OAUTH_REDIRECT="http://localhost:3001/api/threads/callback"

# --- ИИ (генерация постов/шаблонов) ---
ANTHROPIC_API_KEY=""

# --- Биллинг ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Сервер ---
PORT=3001
WEB_ORIGIN="http://localhost:3000"
