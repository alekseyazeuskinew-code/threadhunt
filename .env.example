# --- БД и очереди ---
# Локальное превью (без Docker): SQLite-файл.
DATABASE_URL="file:./dev.db"
# Прод: Postgres (поменяй provider в prisma/schema.prisma на "postgresql"):
# DATABASE_URL="postgresql://threadhunt:threadhunt@localhost:5432/threadhunt?schema=public"

# --- Шифрование токенов клиентов (AES-256-GCM, 32 байта в hex = 64 символа) ---
# Сгенерировать: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# --- Сессии дашборда ---
SESSION_SECRET=""

# --- Threads / Meta OAuth (для авто-постинга) ---
THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_OAUTH_REDIRECT="http://localhost:3001/api/threads/callback"

# --- ИИ (генерация постов/шаблонов) ---
ANTHROPIC_API_KEY=""

# --- Биллинг ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Сервер ---
PORT=3001
WEB_ORIGIN="http://localhost:3000"
# Публичный адрес самого API (https://api.<домен>). НУЖЕН только чтобы Threads мог
# СКАЧАТЬ загруженное на диск медиа при ПУБЛИКАЦИИ. Превью в дашборде работает и без него
# (медиа отдаётся по относительному /api/media/, проксируется на бэкенд). На R2/S3 не нужен.
PUBLIC_BASE_URL=""

# --- Хранилище медиа (загрузка фото/видео для постов) ---
# Если заданы все S3_* — файлы летят в Cloudflare R2 / S3 (постоянно, Threads качает по CDN-URL).
# Если пусто — fallback на локальный диск (./uploads, отдаётся по /api/media/). Для ПУБЛИКАЦИИ
# загруженного медиа в Threads тогда задай PUBLIC_BASE_URL (или используй R2 — надёжнее).
S3_ENDPOINT=""            # напр. https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"          # для R2 — auto
S3_PUBLIC_BASE_URL=""     # публичный домен бакета/CDN, напр. https://cdn.<домен>
